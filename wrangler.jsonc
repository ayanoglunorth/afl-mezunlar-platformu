{
	"$schema": "node_modules/wrangler/config-schema.json",
	"main": "cloudflare-worker.js",
	"name": "afl-mezunlar-platformu",
	"compatibility_date": "2026-07-27",
	"compatibility_flags": [
		"nodejs_compat",
		"global_fetch_strictly_public"
	],
	"workers_dev": true,
	"assets": {
		"directory": ".open-next/assets",
		"binding": "ASSETS"
	},
	"triggers": {
		"crons": [
			"*/5 * * * *"
		]
	}
}
