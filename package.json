    "@supabase/supabase-js": "^2.110.6",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "next": "16.3.8",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "tailwind-merge": "^3.6.0",
    "xlsx": "npm:@keep-lts/xlsx@^0.18.6"
  },
  "overrides": {
    "postcss": "^8.5.23",
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
